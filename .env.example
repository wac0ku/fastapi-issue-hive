# All keys are OPTIONAL — the hive runs fully offline in heuristic mode without them.

# Anthropic API key (https://console.anthropic.com)
# Enables Claude-enhanced diagnosis on top of the heuristic knowledge base.
ANTHROPIC_API_KEY=

# GitHub token (https://github.com/settings/tokens, "public_repo" scope is enough)
# Raises the GitHub API rate limit when scanning repositories for issues.
GITHUB_TOKEN=

# Claude model used by the workers when an API key is present.
HIVE_MODEL=claude-sonnet-5

# Server-side cap on how many issues a single repo scan fetches.
MAX_ISSUES_PER_REPO=10

# How many issues of a scan are analysed at once. Bounds how many Claude calls a
# single request can have in flight.
MAX_CONCURRENT_ANALYSES=5

# Time budget for a whole repo scan; exceeding it returns 504.
SCAN_TIMEOUT_SECONDS=120
